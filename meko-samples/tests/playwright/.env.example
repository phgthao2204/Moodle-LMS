# ==============================================================================
# ACCEES-LMS REST API v2 - Playwright E2E Test Suite Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables to match target environment.
# NEVER commit .env or secrets to Git.

# 1. Target LMS Base URL (supports sub-directory like /lms or sub-domain HTTPS)
# Examples:
#   - DevLocal Docker       : http://meko.localhost/lms
#   - Remote Dev / Staging  : http://dev-lms.local/lms
#   - Production Domain     : https://lms.example.com
LMS_BASE_URL=http://meko.localhost/lms

# 2. OAuth 2.0 Client Credentials
# Used to acquire Bearer JWT via POST ${LMS_BASE_URL}/oauth2/token
OAUTH_CLIENT_ID=accees-dev-client
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=local_accees_imscp:imscp:import local_accees_imscp:imscp:export local_accees_sync_api:course:read local_accees_sync_api:course:write local_accees_sync_api:enrol:manage local_accees_sync_api:result:read

# 3. Optional Debug Personal Access Token (PAT)
# If provided, the test suite can use this token directly (helpful on DevLocal when OAuth2 server package is omitted)
DEBUG_PAT=

# 4. ACCEES API Version Header (X-ACCEES-API-Version: 1.0 or 1.1)
ACCEES_API_VERSION=1.0

# 5. SSL / TLS Verification (set to true when testing with self-signed SSL on dev/staging servers)
IGNORE_HTTPS_ERRORS=true

# 6. Test Data Parameters
TEST_CATEGORY_ID=2
SAMPLE_COURSE_ID=2
SAMPLE_COURSE_SHORTNAME=ACCEES-CS101

# 7. Webhook Validation (UC-LMS-14)
WEBHOOK_RECEIVER_URL=http://localhost:8080/webhook
WEBHOOK_SECRET=default_webhook_secret_key

