# ==============================================================================
# MEKOSOFT DEVLOCAL STACK - UNIFIED ENVIRONMENT CONFIG
# Liferay 7.4 GA132 (CMS + TMS) + Moodle 5.3 (LMS) + PostgreSQL 17 + Nginx
# ==============================================================================

DOMAIN=meko.localhost
HTTP_PORT=80

# Shared PostgreSQL 17 Server
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=DevLocalRoot2026!@#

# Liferay Database
LIFERAY_DB=lportal
LIFERAY_DB_USER=liferay
LIFERAY_DB_PASS=LiferayPass2026!@#

# Moodle Database
MOODLE_DB=accees_lms
MOODLE_DB_USER=lms_user
MOODLE_DB_PASS=LmsPassword2026!@#

# Moodle Brand
MOODLE_BRAND_PROFILE=meko
MAILPIT_PORT=8025

# Liferay JVM Memory (Toi uu cho Docker Desktop 6GB-8GB RAM; may 16GB+ RAM co the tang len -Xms1536m -Xmx2048m)
LIFERAY_JVM_OPTS=-Xms768m -Xmx1280m -XX:NewSize=256m -XX:MaxNewSize=512m -XX:MetaspaceSize=256m -XX:MaxMetaspaceSize=512m
