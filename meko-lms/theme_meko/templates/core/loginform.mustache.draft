{{!
    @template core/loginform

    ACCEES-LMS Custom Login Form Template (Task 4 / #4101).
    100% compliant with ACCEES LMS Design System v2.0 (#sec-logo, #sec-btn).
    Prioritizes Single Sign-On via ACCEES-SSO (Keycloak OIDC) and collapses Local Admin login.
}}
<div class="accees-login-card mx-auto">
    <div class="accees-login-header text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center mb-3" style="gap: 10px;">
            <img src="{{#logourl}}{{{logourl}}}{{/logourl}}{{^logourl}}{{{config.wwwroot}}}/theme/accees_lms_theme/pix/logo.png{{/logourl}}" alt="ACCEES Logo" style="height: 44px; width: auto; object-fit: contain;">
            
        </div>
        <h2 class="accees-login-title">{{#str}}login_heading, theme_meko{{/str}}</h2>
        <p class="accees-login-subtitle text-muted small mb-0">{{#str}}login_subheading, theme_meko{{/str}}</p>
    </div>

    {{#error}}
        <div class="alert alert-danger" role="alert" id="loginerrormessage">
            {{error}}
        </div>
    {{/error}}

    {{#info}}
        <div class="alert alert-info" role="alert">
            {{info}}
        </div>
    {{/info}}

    <!-- 1. PRIMARY CTA: ACCEES-SSO (KEYCLOAK OIDC) -->
    <div class="accees-sso-box mb-4">
        {{#hasidentityproviders}}
            {{#identityproviders}}
                <a class="btn btn-accees-sso w-100 d-flex align-items-center justify-content-center mb-2" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="20" height="20" class="me-2"/>
                    {{/iconurl}}
                    {{^iconurl}}
                        <i class="fa-solid fa-key me-2"></i>
                    {{/iconurl}}
                    <span>{{name}}</span>
                </a>
            {{/identityproviders}}
        {{/hasidentityproviders}}
        {{^hasidentityproviders}}
            <a class="btn btn-accees-sso w-100 d-flex align-items-center justify-content-center" href="https://sso.dev3.accees.vn/realms/accees/account">
                <i class="fa-solid fa-key me-2"></i>
                <span>{{#str}}login_sso_cta, theme_meko{{/str}}</span>
            </a>
        {{/hasidentityproviders}}
    </div>

    <div class="accees-login-divider text-center my-3">
        <span>{{#str}}login_admin_divider, theme_meko{{/str}}</span>
    </div>

    <!-- 2. SECONDARY COLLAPSIBLE: LOCAL MOODLE ADMIN LOGIN -->
    <details class="accees-local-login-collapse" {{#error}}open{{/error}}>
        <summary class="accees-local-login-summary">
            <i class="fa-solid fa-user-shield me-1" style="color: #0000B6;"></i> {{#str}}login_local_admin_toggle, theme_meko{{/str}}
        </summary>
        <form class="mt-3" action="{{loginurl}}" method="post" id="login">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <div class="form-group mb-3">
                <label for="username" class="small font-weight-bold text-dark">{{#str}} username {{/str}}</label>
                <input type="text" name="username" id="username" class="form-control" value="{{username}}" placeholder="{{#str}} username {{/str}}" autocomplete="username">
            </div>
            <div class="form-group mb-3">
                <label for="password" class="small font-weight-bold text-dark">{{#str}} password {{/str}}</label>
                <input type="password" name="password" id="password" class="form-control" value="" placeholder="{{#str}} password {{/str}}" autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-primary w-100 font-weight-bold" id="loginbtn" style="background-color: #0000B6 !important; border: none; padding: 10px; border-radius: 8px;">
                <i class="fa-solid fa-right-to-bracket me-1"></i> {{#str}} login {{/str}}
            </button>
        </form>
    </details>
</div>
