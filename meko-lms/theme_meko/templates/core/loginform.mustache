{{!
    @template core/loginform
    MEKOSOFT LMS - Modern Direct Login Form Template
}}
<div class="loginform">
    <p class="login-institution-note">
        {{#str}} login_institution_desc, theme_meko {{/str}}
    </p>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance mb-3" role="alert">
            {{{maintenance}}}
        </div>
    {{/maintenance}}

    {{#error}}
        <div class="alert alert-danger meko-login-alert d-flex align-items-center mb-3" id="loginerrormessage" role="alert">
            <svg class="flex-shrink-0 me-2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div id="login-error-text-container">
                {{#errortitle}}<strong class="d-block meko-error-title">{{errortitle}}</strong>{{/errortitle}}
                <span class="meko-error-detail">{{error}}</span>
            </div>
        </div>
    {{/error}}

    {{#info}}
        <div class="alert alert-info meko-login-alert mb-3" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form meko-login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <!-- 1. Username / Email Field with Inline Icon inside Label -->
            <div class="login-form-username meko-form-group mb-3">
                <label for="username" class="meko-label d-inline-flex align-items-center gap-2 mb-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary" style="flex-shrink:0;">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <span>
                        {{#canloginbyemail}}
                            {{#str}} usernameemail, core {{/str}}
                        {{/canloginbyemail}}
                        {{^canloginbyemail}}
                            {{#str}} username, core {{/str}}
                        {{/canloginbyemail}}
                    </span>
                </label>
                <input type="text" name="username" id="username"
                    class="form-control meko-input"
                    value="{{username}}"
                    placeholder="{{^canloginbyemail}}{{#str}}enterusername, core{{/str}}{{/canloginbyemail}}{{#canloginbyemail}}{{#str}}loginenterusernameoremail, core{{/str}}{{/canloginbyemail}}"
                    autocomplete="username" required>
            </div>

            <!-- 2. Password Field with Inline Icon inside Label & Inline Eye Toggle -->
            <div class="login-form-password meko-form-group mb-3">
                <label for="password" class="meko-label d-inline-flex align-items-center gap-2 mb-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary" style="flex-shrink:0;">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>{{#str}} password, core {{/str}}</span>
                </label>
                <div class="input-group meko-password-group">
                    <input type="password" name="password" id="password" value=""
                        class="form-control meko-input"
                        placeholder="{{#str}}loginenterpassword, core{{/str}}"
                        autocomplete="current-password" required>
                    <button class="btn meko-eye-toggle-btn" type="button" id="togglePasswordBtn" aria-label="Toggle password visibility">
                        <svg class="eye-icon-show" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg class="eye-icon-hide d-none" style="display: none !important;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- 3. Remember Login Checkbox (Flush Left) & Forgot Password Link -->
            <div class="d-flex justify-content-between align-items-center mb-3 meko-form-options">
                <div class="form-check meko-remember-box mb-0 p-0 ms-0">
                    <input class="form-check-input m-0 me-2" type="checkbox" name="rememberusername" id="rememberusername" value="1" {{#rememberusername}}checked="checked"{{/rememberusername}}>
                    <label class="form-check-label small" for="rememberusername">
                        {{#str}} remember_login, theme_meko {{/str}}
                    </label>
                </div>
                <div class="meko-forgot-box ms-auto">
                    <a href="{{forgotpasswordurl}}" class="meko-forgot-link">{{#str}} forgotpassword, theme_meko {{/str}}</a>
                </div>
            </div>

            <!-- 4. Submit Button -->
            <div class="login-form-submit mb-2">
                <button class="btn btn-primary w-100 meko-submit-btn" type="submit" id="loginbtn">{{#str}}login, core{{/str}}</button>
            </div>
        </form>
    {{/showloginform}}
</div>

<script>
(function() {
    // 1. Password eye toggle
    var toggleBtn = document.getElementById('togglePasswordBtn');
    var passwordInput = document.getElementById('password');
    if (toggleBtn && passwordInput) {
        toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var isPass = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPass ? 'text' : 'password');
            var showIcon = toggleBtn.querySelector('.eye-icon-show');
            var hideIcon = toggleBtn.querySelector('.eye-icon-hide');
            if (showIcon && hideIcon) {
                if (isPass) {
                    showIcon.style.setProperty('display', 'none', 'important');
                    hideIcon.style.setProperty('display', 'inline-block', 'important');
                    showIcon.classList.add('d-none');
                    hideIcon.classList.remove('d-none');
                    toggleBtn.classList.add('is-showing-password');
                } else {
                    showIcon.style.setProperty('display', 'inline-block', 'important');
                    hideIcon.style.setProperty('display', 'none', 'important');
                    showIcon.classList.remove('d-none');
                    hideIcon.classList.add('d-none');
                    toggleBtn.classList.remove('is-showing-password');
                }
            }
            passwordInput.focus();
        });
    }

    // 2. Vietnamese translation fallback for login failure message and forgot password
    var isVi = document.documentElement.lang === 'vi' || 
               document.body.classList.contains('lang-vi') || 
               window.location.search.indexOf('lang=vi') !== -1 ||
               (window.location.search.indexOf('lang=') === -1 && (document.title.indexOf('Đăng nhập') !== -1 || (document.querySelector('.login-heading') && document.querySelector('.login-heading').textContent.indexOf('Đăng nhập') !== -1)));
    if (isVi) {
        var errTitle = document.querySelector('.meko-error-title');
        var errDetail = document.querySelector('.meko-error-detail');
        if (errTitle && errTitle.textContent.trim().toLowerCase().includes('unable to log in')) {
            errTitle.textContent = 'Không thể đăng nhập';
        }
        if (errDetail && errDetail.textContent.trim().toLowerCase().includes('login info may be incorrect')) {
            errDetail.textContent = 'Tên tài khoản hoặc mật khẩu không chính xác. Vui lòng thử lại.';
        }
        var forgotLink = document.querySelector('.meko-forgot-link');
        if (forgotLink && forgotLink.textContent.trim().toLowerCase().includes('forgot password')) {
            forgotLink.textContent = 'Quên mật khẩu?';
        }
    }

    // 3. Remember login (Ghi nhớ đăng nhập) feature
    var usernameField = document.getElementById('username');
    var rememberBox = document.getElementById('rememberusername');
    var formEl = document.getElementById('login');

    if (usernameField && rememberBox) {
        var storedUser = localStorage.getItem('meko_remember_username');
        if (storedUser && storedUser.length > 0) {
            if (!usernameField.value || usernameField.value.trim() === '') {
                usernameField.value = storedUser;
            }
            rememberBox.checked = true;
        }

        if (formEl) {
            formEl.addEventListener('submit', function() {
                if (rememberBox.checked && usernameField.value.trim() !== '') {
                    localStorage.setItem('meko_remember_username', usernameField.value.trim());
                } else if (!rememberBox.checked) {
                    localStorage.removeItem('meko_remember_username');
                }
            });
        }
    }
})();
</script>
