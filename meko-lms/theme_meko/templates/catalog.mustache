            name: 'Miền 1: Môi trường nghề nghiệp số',
            competencies: [
              {
                code: 'GV_1_1',
                name: 'Giao tiếp trong tổ chức giáo dục',
                levels: [
                  { code: 'BASIC', idnumber: 'GV_1_1_BASIC', title: 'Bậc Cơ bản (Basic)', badge_class: 'n1', statement: 'Sử dụng các kênh số của trường để thông báo lịch học và chia sẻ quy chế đào tạo.' },
                  { code: 'INTERMEDIATE', idnumber: 'GV_1_1_INTERMEDIATE', title: 'Bậc Trung cấp', badge_class: 'n2', statement: 'Thiết lập các kênh tương tác số đa chiều giữa giảng viên và người học.' },
                  { code: 'ADVANCED', idnumber: 'GV_1_1_ADVANCED', title: 'Bậc Nâng cao', badge_class: 'n3', statement: 'Dẫn dắt chiến lược truyền thông và hợp tác số trong khoa/trường.' }
