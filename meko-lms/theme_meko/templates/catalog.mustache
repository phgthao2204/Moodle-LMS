              }
            ]
          },
          {
            code: 'Miền 3',
            name: 'Miền 3: Dạy và học số',
            competencies: [
              {
                code: 'GV_3_1',
                name: 'Tổ chức giảng dạy trực tuyến',
                levels: [
                  { code: 'BASIC', idnumber: 'GV_3_1_BASIC', title: 'Bậc Cơ bản (Basic)', badge_class: 'n1', statement: 'Sử dụng Moodle để đăng tải giáo trình và tạo bài kiểm tra trắc nghiệm đơn giản.' },
                  { code: 'INTERMEDIATE', idnumber: 'GV_3_1_INTERMEDIATE', title: 'Bậc Trung cấp', badge_class: 'n2', statement: 'Thiết kế khóa học kết hợp (Blended Learning) với lộ trình năng lực số rõ ràng.' }
                ]
              }
            ]
          },
          {
            code: 'Miền 4',
            name: 'Miền 4: Đánh giá và kiểm tra số',
            competencies: [
              {
                code: 'GV_4_1',
                name: 'Chiến lược đánh giá năng lực số (CBE)',
                levels: [
                  { code: 'BASIC', idnumber: 'GV_4_1_BASIC', title: 'Bậc Cơ bản (Basic)', badge_class: 'n1', statement: 'Áp dụng quiz online chấm điểm tự động để đánh giá mức độ ghi nhớ kiến thức.' },
                  { code: 'INTERMEDIATE', idnumber: 'GV_4_1_INTERMEDIATE', title: 'Bậc Trung cấp', badge_class: 'n2', statement: 'Thiết lập Rubric đánh giá năng lực số đa tiêu chí gắn với thang chuẩn CBE.' },
                  { code: 'ADVANCED', idnumber: 'GV_4_1_ADVANCED', title: 'Bậc Nâng cao', badge_class: 'n3', statement: 'Xây dựng ngân hàng câu hỏi thích ứng (Adaptive Testing) dựa trên dữ liệu học tập.' }
                ]
              }
            ]
          },
          {
            code: 'Miền A',
            name: 'Miền A: Trí tuệ nhân tạo (AI) trong Giáo dục',
            competencies: [
              {
                code: 'GV_A_1',
                name: 'Ứng dụng GenAI trong thiết kế bài giảng',
                levels: [
                  { code: 'BASIC', idnumber: 'GV_A_1_BASIC', title: 'Bậc Cơ bản (Basic)', badge_class: 'n1', statement: 'Sử dụng prompt cơ bản với ChatGPT/Claude để gợi ý ý tưởng xây dựng đề cương môn học.' },
                  { code: 'INTERMEDIATE', idnumber: 'GV_A_1_INTERMEDIATE', title: 'Bậc Trung cấp', badge_class: 'n2', statement: 'Tối ưu prompt đa bước để tạo case study, rubric và kịch bản thực hành cho sinh viên.' }
                ]
              }
            ]
          }
