{{! MEKO catalog styled after the attached Moodle catalog mockup. }}
<div class="meko-catalog-page">
  <header class="meko-catalog-nav">
    <div class="meko-catalog-nav-inner">
      <a class="meko-catalog-brand" href="{{homeurl}}" aria-label="MEKOSOFT LMS">
        <img src="{{logourl}}" alt="MEKOSOFT">
      </a>
      <nav aria-label="{{#str}} nav_main_menu, theme_meko {{/str}}">
        <a href="{{homeurl}}">{{#str}} nav_home, theme_meko {{/str}}</a>
        <a class="is-active" href="{{catalogurl}}">{{#str}} nav_catalog, theme_meko {{/str}}</a>
        {{#isloggedin}}<a href="{{mycoursesurl}}">{{#str}} nav_mycourses, theme_meko {{/str}}</a>{{/isloggedin}}
        <a href="{{competenciesurl}}">{{#str}} nav_competencies, theme_meko {{/str}}</a>
      </nav>
      <div class="meko-catalog-account">
        <div class="lang-switch-cluster" aria-label="Ngôn ngữ">
          <a class="lang-circle-btn{{#langvi}} active{{/langvi}}" href="{{langviurl}}" lang="vi"{{#langvi}} aria-current="true"{{/langvi}}>VI</a>
          <a class="lang-circle-btn{{#langen}} active{{/langen}}" href="{{langenurl}}" lang="en"{{#langen}} aria-current="true"{{/langen}}>EN</a>
          <a class="lang-circle-btn{{#langfr}} active{{/langfr}}" href="{{langfrurl}}" lang="fr"{{#langfr}} aria-current="true"{{/langfr}}>FR</a>
        </div>
        {{#isloggedin}}
          <a href="{{userprofileurl}}">{{userfullname}}</a>
          <a href="{{logouturl}}">{{#str}} nav_logout, theme_meko {{/str}}</a>
        {{/isloggedin}}
        {{^isloggedin}}<a class="meko-catalog-login" href="{{loginurl}}">{{#str}} login, theme_meko {{/str}} SSO</a>{{/isloggedin}}
      </div>
    </div>
  </header>
  <div class="container">
    <!-- Breadcrumbs Bar -->
    <div class="breadcrumb-bar" id="breadcrumbBar">
      <a href="{{homeurl}}">{{#str}} nav_home, theme_meko {{/str}}</a> &nbsp;&gt;&nbsp;
      <a href="javascript:void(0)" onclick="clearAllFilters()">{{#str}} nav_catalog, theme_meko {{/str}}</a>
      <span id="bcCategoryText">Lĩnh vực 01: Dữ liệu &amp; Nội dung số</span>
      <span id="bcDomainText">D1. Thông tin và dữ liệu số</span>
      <strong id="bcLevelText">C1.1 [Bậc N1 - Cơ bản]</strong>
    </div>

    <!-- ============================================== -->
    <!-- 2. THANH BỘ LỌC ĐANG ÁP DỤNG (MULTI-FACET CHIPS)-->
    <!-- ============================================== -->
    <div class="active-filters-strip" id="activeFiltersStrip">
      <div class="active-filters-left">
        <span class="filter-label-icon">{{#str}} catalogactivefilters, theme_meko {{/str}}</span>

        <!-- Category Chip -->
        <span class="filter-chip chip-category" id="chipCategory" style="display: inline-flex;">
          <span>Lĩnh vực: <strong id="chipCategoryName">Lĩnh vực 01: Dữ liệu &amp; Nội dung số</strong></span>
          <button class="chip-remove-btn" onclick="clearCategory()" title="Bỏ lọc lĩnh vực này">✕</button>
        </span>

        <!-- Framework Chip -->
        <span class="filter-chip chip-framework" id="chipFramework" style="display: inline-flex;">
          <span>Khung: <strong id="chipFrameworkName">Sinh viên (DigComp 2.2)</strong></span>
        </span>

        <!-- Competency Chip -->
        <span class="filter-chip chip-competency" id="chipCompetency" style="display: inline-flex;">
          <span>Chuẩn: <strong id="chipCompetencyName">SV_C1_1_N1</strong> (<span id="chipCompetencyLevel">Bậc N1</span>)</span>
          <button class="chip-remove-btn" onclick="clearCompetency()" title="Bỏ lọc chuẩn đầu ra này">✕</button>
        </span>
      </div>

      <div>
        <button class="btn-clear-all" onclick="clearAllFilters()">✕ {{#str}} clearfilters, theme_meko {{/str}}</button>
      </div>
    </div>

    <!-- Main Layout: 2 Columns (Sidebar + Courses Catalog) -->
    <div class="catalog-layout">

      <!-- ============================================== -->
      <!-- CỘT TRÁI: SIDEBAR BỘ LỌC ĐA CHIỀU (MULTI-FACET) -->
      <!-- ============================================== -->
      <aside class="catalog-sidebar">

        <!-- Widget 1: CHUẨN ĐẦU RA NĂNG LỰC SỐ (CÓ SWITCHER KHUNG & CÂY DUYỆT TẤT CẢ) -->
        <div class="sidebar-widget">
          <div class="widget-header">
            <span>{{#str}} catalogcompetencies, theme_meko {{/str}}</span>
            <span style="font-size: 11px; color: var(--meko-primary);" id="sidebarFrameworkCount">18 Năng lực</span>
          </div>
          <div class="widget-body">

            <!-- Framework Switcher Tab (Sinh viên vs Giảng viên) -->
            <div class="framework-tabs-switcher">
              <button class="framework-tab-btn active" id="tabBtnStudents" onclick="switchFramework('students')">
                Sinh viên
              </button>
              <button class="framework-tab-btn" id="tabBtnFaculty" onclick="switchFramework('faculty')">
                 Giảng viên
              </button>
            </div>

            <!-- Search within competencies tree -->
            <div class="sidebar-search-box">
              <span class="sidebar-search-icon"></span>
              <input type="text" class="sidebar-search-input" placeholder="Tìm năng lực, mã số..." oninput="handleSidebarCompSearch(this.value)">
            </div>

            <!-- Collapsible Competency Tree -->
            <ul class="comp-tree-list" id="compTreeList">
              <!-- Rendered dynamically by JS -->
            </ul>

            <!-- Button to open Quick Selector Modal -->
            <button class="btn-open-picker-modal" onclick="openCompetencyModal()">
              <span>Mở bộ chọn nhanh toàn bộ khung</span>
            </button>
          </div>
        </div>

        <!-- Widget 2: CÂY DANH MỤC 6 LĨNH VỰC ĐÀO TẠO GỐC MOODLE -->
        <div class="sidebar-widget">
          <div class="widget-header">
            <span>{{#str}} catalogtrainingareas, theme_meko {{/str}}</span>
            <span style="font-size: 11px; color: #6B7280;">6 Lĩnh vực</span>
          </div>
          <div class="widget-body">
            <ul class="cat-tree-list" id="catTreeList">
              <!-- Rendered dynamically by JS -->
            </ul>
          </div>
        </div>

      </aside>

      <!-- ============================================== -->
      <!-- CỘT PHẢI: KHU VỰC HIỂN THỊ KHÓA HỌC & BANNER    -->
      <!-- ============================================== -->
      <main class="catalog-main">

        <!-- 1. BANNER LỌC THEO BẬC NĂNG LỰC SỐ -->
        <section class="competency-filter-banner" id="bannerFilter">
          <div class="banner-top-row">
            <div>
              <div class="banner-hierarchy-path">
                <span class="tag-tier tag-tier-domain" id="bannerTierDomain">MIỀN 1</span>
                <span id="bannerDomainName">D1. Thông tin và dữ liệu số</span> &nbsp;&gt;&nbsp;
                <span class="tag-tier tag-tier-comp" id="bannerTierComp">NĂNG LỰC</span>
                <span id="bannerCompName">C1.1. Tìm kiếm thông tin và dữ liệu</span>
              </div>
              <h1 class="banner-title">
                <span class="tag-tier tag-tier-level" id="bannerTierLevel">BẬC MỤC TIÊU</span>
                <span id="bannerLevelTitle">Bậc N1 - Cơ bản (Basic)</span>
                <span class="banner-level-badge n1" id="bannerLevelBadge">N1</span>
                <span class="banner-id-tag" id="bannerIdTag">SV_C1_1_N1</span>
              </h1>
            </div>

            <div class="banner-actions">
              <button class="btn-modal-trigger" onclick="openCompetencyModal()" title="Chọn sang một chuẩn năng lực khác">
                <span>Đổi chuẩn năng lực</span>
              </button>
              <button class="btn-tree-link" onclick="clearCompetency()" title="Bỏ lọc chuẩn năng lực">
                ✕ Xóa lọc năng lực
              </button>
            </div>
          </div>

          <!-- Specific Statement Box -->
          <div class="banner-statement-box">
            <strong>Yêu cầu chuẩn đầu ra Bậc mục tiêu:</strong>
            <span id="bannerStatementText">
              Thực hiện tìm kiếm đơn giản bằng cách dùng các từ khóa đơn lẻ trên công cụ tìm kiếm, thường theo chỉ dẫn. Dựa vào kết quả mặc định mà không lọc hay kiểm tra độ tin cậy.
            </span>
          </div>

          <!-- Banner Footer -->
          <div class="banner-footer-row">
            <div class="banner-count-text">
              Khung: <strong id="bannerFrameworkName">DigComp MEKO Students v1.0</strong> •
              <span id="bannerIntersectionText">Đang lọc theo <strong>Lĩnh vực 01: Dữ liệu &amp; Nội dung số</strong>: hiển thị <strong id="bannerCourseCount">02</strong> khóa học đạt chuẩn</span>
            </div>
            <div style="font-size: 11.5px; color: #047857; font-weight: 700; display: flex; align-items: center; gap: 4px;">
              <span>✓ Tự động công nhận chuẩn CBE khi hoàn thành khóa</span>
            </div>
          </div>
        </section>

        <!-- 2. TOOLBAR TÌM KIẾM TRONG KẾT QUẢ & SẮP XẾP -->
        <div class="course-control-toolbar">
          <div class="search-within-box">
            <span class="search-within-icon"></span>
            <input type="text" class="search-within-input" placeholder="{{#str}} catalogsearchcourses, theme_meko {{/str}}..." oninput="handleCourseSearch(this.value)">
          </div>
          <div class="results-count-text">
            <span>{{#str}} catalogshowing, theme_meko {{/str}}: <strong id="resultsCount">02</strong> {{#str}} catalogcoursesfound, theme_meko {{/str}}</span>
          </div>
        </div>

        <!-- 3. LƯỚI KHÓA HỌC ĐẠT CHUẨN ĐẦU RA BẬC NÀY -->
        <div class="courses-grid" id="coursesGrid">
          <!-- Rendered dynamically -->
        </div>

        <!-- 4. INTELLIGENT EMPTY STATE (GỢI Ý NỚI LỎNG BỘ LỌC) -->
        <div class="empty-state-card" id="emptyStateCard" style="display: none;">
          <div class="empty-icon"></div>
          <h3 class="empty-title">{{#str}} catalognocourses, theme_meko {{/str}}</h3>
          <p class="empty-desc" id="emptyDescText">
            Hiện tại chưa có khóa học nào thuộc <strong id="emptyCatName">Lĩnh vực đã chọn</strong> đáp ứng chuẩn đầu ra <strong id="emptyCompName">Bậc năng lực này</strong>. Bạn có thể nới lỏng bộ lọc để tiếp tục:
          </p>
          <div class="empty-actions-row">
            <button class="btn-relax-filter" id="btnRelaxCategory" onclick="clearCategory()">
              Xem khóa học đạt chuẩn này ở TẤT CẢ lĩnh vực
            </button>
            <button class="btn-relax-filter" id="btnRelaxComp" onclick="clearCompetency()">
              Xem tất cả khóa học của lĩnh vực này
            </button>
            <button class="btn-relax-filter" onclick="clearAllFilters()">
              ✕ Xóa tất cả bộ lọc
            </button>
          </div>
        </div>

      </main>

    </div>

  </div>

  <!-- ============================================== -->
  <!-- MODAL / DRAWER: BỘ CHỌN CHUẨN NĂNG LỰC NHANH   -->
  <!-- ============================================== -->
  <div class="modal-overlay" id="competencyModal" onclick="closeCompetencyModalOnBackdrop(event)">
    <div class="picker-modal">
      <div class="modal-header">
        <div class="modal-title">
          <span>BỘ CHỌN CHUẨN ĐẦU RA NĂNG LỰC SỐ (MEKO CBE)</span>
        </div>
        <button class="btn-close-modal" onclick="closeCompetencyModal()">✕</button>
      </div>

      <div class="modal-subbar">
        <!-- Modal Framework Switcher -->
        <div class="framework-tabs-switcher" style="margin-bottom: 0; min-width: 260px;">
          <button class="framework-tab-btn active" id="modalTabBtnStudents" onclick="switchFramework('students')">
            Khung Sinh viên (18 NL)
          </button>
          <button class="framework-tab-btn" id="modalTabBtnFaculty" onclick="switchFramework('faculty')">
             Khung Giảng viên (28 NL)
          </button>
        </div>

        <!-- Modal Search Box -->
        <div class="modal-search-box">
          <span class="search-within-icon"></span>
          <input type="text" class="modal-search-input" id="modalSearchInput" placeholder="Tìm kiếm năng lực (ví dụ: tìm kiếm, AI, an ninh, trích dẫn, C2.1)..." oninput="handleModalSearch(this.value)">
        </div>
      </div>

      <div class="modal-body-scroll" id="modalBodyScroll">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <div style="font-size: 1.3rem; font-weight: 800; color: #FFF; margin-bottom: 8px;">MEKO LMS</div>
        <p style="line-height: 1.6; font-size: 13px;">
          Hệ sinh thái Đào tạo Số MEKO (MEKO-DLE) do Tập đoàn MEKOSOFT phát triển và làm chủ công nghệ, cung cấp nền tảng quản lý đào tạo dựa trên năng lực (CBE). chương trình MEKOSOFT của Tập đoàn Công nghệ MEKOSOFT.<br>
          Cơ quan điều phối: <strong>Tập đoàn Công nghệ MEKOSOFT</strong>.
        </p>
      </div>
      <div>
        <div class="footer-heading">Hệ sinh thái số MEKO</div>
        <p style="font-size: 13px; line-height: 1.8;">
          • <a href="https://repo.mekosoft.vn" target="_blank">Kho học liệu số DLRP &rarr;</a><br>
          • <a href="https://tms.mekosoft.vn" target="_blank">Quản lý đào tạo TMS &rarr;</a><br>
          • <a href="{{loginurl}}">Đăng nhập một lần SSO &rarr;</a><br>
          • <a href="https://mekosoft.vn" target="_blank">Cổng thông tin dự án MEKOSOFT &rarr;</a>
        </p>
      </div>
      <div>
        <div class="footer-heading">Tiêu chuẩn năng lực</div>
        <p style="font-size: 13px; line-height: 1.8;">
          • <a href="{{competenciesurl}}?tab=student" style="color:#93C5FD;">DigComp Students v1.0 (/dig-comp-student)</a><br>
          • <a href="{{competenciesurl}}?tab=lecturer" style="color:#93C5FD;">DigComp Faculty v1.0 (/dig-comp-lecturer)</a><br>
          • Moodle 5.3 LTS CBE Option A (Compound Filter)<br>
          • Open Badges 3.0 W3C VC
        </p>
      </div>
    </div>
    <div class="container footer-bottom">
      © 2026 Bản quyền thuộc về Hệ sinh thái MEKO (MEKOSOFT). Tài liệu được cấp phép theo Giấy phép Creative Commons CC-BY-NC 4.0.
    </div>
  </footer>


