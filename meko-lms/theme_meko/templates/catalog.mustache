    // Moodle course data and assigned competencies.
    const COURSES_DB = {{{coursejson}}};

    // ==============================================
    // TRẠNG THÁI TOÀN CỤC BỘ LỌC (GLOBAL FILTER STATE)
    // ==============================================
    let currentFrameworkKey = 'students';   // 'students' | 'faculty'
    let currentCategoryId = null;
    let currentCompetencyId = null;
    let currentSearchQuery = '';

    // Khởi tạo trang
    window.addEventListener('DOMContentLoaded', () => {
      // Đọc tham số URL nếu được điều hướng từ trang Khung năng lực hoặc trang khác
      const params = new URLSearchParams(window.location.search);
      if (params.has('competencyid')) {
        const compId = params.get('competencyid');
        currentCompetencyId = compId;
        if (compId.startsWith('GV_')) {
          currentFrameworkKey = 'faculty';
        } else {
          currentFrameworkKey = 'students';
        }
      }
      if (params.has('categoryid')) {
        currentCategoryId = parseInt(params.get('categoryid'));
      }
      renderAll();
    });

    // Chuyển đổi Khung Năng Lực (Framework)
    function switchFramework(fwKey) {
      if (currentFrameworkKey === fwKey) return;
      currentFrameworkKey = fwKey;

      // Nếu competency hiện tại không thuộc khung mới, đổi sang competency mặc định của khung mới
      const compObj = findCompetencyInFramework(currentCompetencyId, fwKey);
      if (!compObj) {
        if (fwKey === 'students') {
          currentCompetencyId = 'SV_C1_1_N1';
        } else {
          currentCompetencyId = 'GV_4_1_INTERMEDIATE';
        }
      }

      renderAll();
    }

    // Chọn Lĩnh vực (Category)
    function setCategory(catId) {
      currentCategoryId = catId;
      renderAll();
    }

    function clearCategory() {
      currentCategoryId = null;
      renderAll();
    }

    // Chọn Chuẩn đầu ra (Competency)
    function setCompetency(compId) {
      currentCompetencyId = compId;
      // Tự động kiểm tra xem competency này thuộc khung nào
      if (compId.startsWith('GV_')) {
        currentFrameworkKey = 'faculty';
      } else if (compId.startsWith('SV_')) {
        currentFrameworkKey = 'students';
      }
      closeCompetencyModal();
      renderAll();
    }

    function clearCompetency() {
      currentCompetencyId = null;
      renderAll();
    }

    function clearAllFilters() {
      currentCategoryId = null;
      currentCompetencyId = null;
      currentSearchQuery = '';
      renderAll();
    }

    // Tìm kiếm thông tin năng lực
    function findCompetencyInFramework(compId, fwKey) {
      if (!compId) return null;
      const fw = FRAMEWORKS_DATA[fwKey];
      if (!fw) return null;

      for (const d of fw.domains) {
        for (const c of d.competencies) {
          for (const lvl of c.levels) {
            if (lvl.idnumber === compId) {
              return {
                domain: d,
                competency: c,
                level: lvl,
                framework: fw
              };
            }
          }
        }
      }
      return null;
    }

    // Tìm kiếm trong toàn bộ các khung
    function findCompetencyAnywhere(compId) {
      return findCompetencyInFramework(compId, 'students') || findCompetencyInFramework(compId, 'faculty');
    }

    // ==============================================
    // MAIN RENDER CONTROLLER
    // ==============================================
    function renderAll() {
      renderBreadcrumbs();
      renderActiveChips();
      renderSidebarCompetencyTree();
      renderSidebarCategoryTree();
      renderBanner();
      renderCoursesGrid();
      updateModalTabs();
    }

    // 2. Render Breadcrumbs
    function renderBreadcrumbs() {
      const bcCat = document.getElementById('bcCategoryText');
      const bcDom = document.getElementById('bcDomainText');
      const bcLvl = document.getElementById('bcLevelText');

      if (currentCategoryId !== null) {
        const cat = CATEGORIES.find(c => c.id === currentCategoryId);
        bcCat.style.display = 'inline';
        bcCat.innerText = cat ? cat.name : 'Lĩnh vực';
      } else {
        bcCat.style.display = 'none';
      }

      const compData = findCompetencyAnywhere(currentCompetencyId);
      if (compData) {
        bcDom.style.display = 'inline';
        bcDom.innerText = compData.domain.name;
        bcLvl.style.display = 'inline';
        bcLvl.innerText = `${compData.competency.code} [${compData.level.title}]`;
      } else {
        bcDom.style.display = 'none';
        bcLvl.style.display = 'none';
      }
    }

    // 3. Render Active Chips
    function renderActiveChips() {
      const strip = document.getElementById('activeFiltersStrip');
      const chipCat = document.getElementById('chipCategory');
      const chipFw = document.getElementById('chipFramework');
      const chipComp = document.getElementById('chipCompetency');

      const hasCat = currentCategoryId !== null;
      const hasComp = currentCompetencyId !== null;

      if (!hasCat && !hasComp) {
        strip.style.display = 'none';
        return;
      }
      strip.style.display = 'flex';

      // Chip Category
      if (hasCat) {
        chipCat.style.display = 'inline-flex';
        const cat = CATEGORIES.find(c => c.id === currentCategoryId);
        document.getElementById('chipCategoryName').innerText = cat ? cat.name : `Lĩnh vực ${currentCategoryId}`;
      } else {
        chipCat.style.display = 'none';
      }

      // Chip Framework & Competency
      if (hasComp) {
        chipFw.style.display = 'inline-flex';
        document.getElementById('chipFrameworkName').innerText = FRAMEWORKS_DATA[currentFrameworkKey].shortname;

        chipComp.style.display = 'inline-flex';
        const compData = findCompetencyAnywhere(currentCompetencyId);
        if (compData) {
          document.getElementById('chipCompetencyName').innerText = compData.level.idnumber;
          document.getElementById('chipCompetencyLevel').innerText = compData.level.code;
        }
      } else {
        chipFw.style.display = 'none';
        chipComp.style.display = 'none';
      }
    }

    // 4. Render Sidebar Competency Tree
    function renderSidebarCompetencyTree() {
      const fw = FRAMEWORKS_DATA[currentFrameworkKey];
      document.getElementById('sidebarFrameworkCount').innerText = `${fw.domains.reduce((sum, d) => sum + d.competencies.length, 0)} Năng lực`;

      // Tabs active
      document.getElementById('tabBtnStudents').className = `framework-tab-btn ${currentFrameworkKey === 'students' ? 'active' : ''}`;
      document.getElementById('tabBtnFaculty').className = `framework-tab-btn ${currentFrameworkKey === 'faculty' ? 'active' : ''}`;

      const treeContainer = document.getElementById('compTreeList');
      let html = '';

      fw.domains.forEach(d => {
        // Kiểm tra xem competency hiện tại có nằm trong domain này không
        const isCurrentDomain = d.competencies.some(c => c.levels.some(l => l.idnumber === currentCompetencyId));

        html += `
          <li class="comp-tree-domain">
            <div class="domain-title-bar" onclick="toggleDomainCollapse(this)">
              <span>${d.name}</span>
              <span style="font-size: 11px;">${isCurrentDomain ? '▾' : '▸'}</span>
            </div>
            <ul class="domain-comp-list" style="display: ${isCurrentDomain ? 'block' : 'none'};">
        `;

        d.competencies.forEach(c => {
          html += `
            <li class="comp-item-block">
              <div class="comp-item-title">
                <span>${c.code}. ${c.name}</span>
              </div>
              <div class="comp-levels-pills">
          `;

          c.levels.forEach(lvl => {
            const isActive = lvl.idnumber === currentCompetencyId;
            html += `
              <button class="comp-level-btn ${isActive ? 'active' : ''}" onclick="setCompetency('${lvl.idnumber}')" title="${lvl.title}">
                ${lvl.code}
              </button>
            `;
          });

          html += `
              </div>
            </li>
          `;
        });

        html += `
            </ul>
          </li>
        `;
      });

      treeContainer.innerHTML = html;
    }

    function toggleDomainCollapse(el) {
      const list = el.nextElementSibling;
      const arrow = el.querySelector('span:last-child');
      if (list.style.display === 'none') {
        list.style.display = 'block';
        arrow.innerText = '▾';
      } else {
        list.style.display = 'none';
        arrow.innerText = '▸';
      }
    }

    // 5. Render Sidebar Category Tree
    function renderSidebarCategoryTree() {
      const listEl = document.getElementById('catTreeList');
      let html = '';

      // Item "Tất cả lĩnh vực"
      const isAllActive = currentCategoryId === null;
      html += `
        <li class="cat-tree-item ${isAllActive ? 'active' : ''}">
          <a href="javascript:void(0)" onclick="clearCategory()">
            <span>Tất cả lĩnh vực</span>
            <span class="cat-count-badge">${COURSES_DB.length}</span>
          </a>
        </li>
      `;

      CATEGORIES.forEach(cat => {
        const isActive = cat.id === currentCategoryId;
        // Đếm số khóa học thuộc lĩnh vực này (có tính cả competency nếu đang chọn)
        const count = COURSES_DB.filter(c => {
          if (c.category_id !== cat.id) return false;
          if (currentCompetencyId && !c.competencies.includes(currentCompetencyId)) return false;
          return true;
        }).length;

        html += `
          <li class="cat-tree-item ${isActive ? 'active' : ''}">
            <a href="javascript:void(0)" onclick="setCategory(${cat.id})">
              <span>${cat.name}</span>
              <span class="cat-count-badge">${count}</span>
            </a>
          </li>
        `;
      });

      listEl.innerHTML = html;
    }

    // 6. Render Banner
    function renderBanner() {
      const banner = document.getElementById('bannerFilter');
      const compData = findCompetencyAnywhere(currentCompetencyId);

      if (!compData) {
        // Khi không lọc theo competency: hiển thị banner giới thiệu danh mục
        banner.style.borderLeftColor = 'var(--meko-navy)';
        document.getElementById('bannerTierDomain').innerText = 'LĨNH VỰC';
        const cat = CATEGORIES.find(c => c.id === currentCategoryId);
        document.getElementById('bannerDomainName').innerText = cat ? cat.name : 'Tất cả lĩnh vực đào tạo';
        document.getElementById('bannerTierComp').innerText = 'CHẾ ĐỘ';
        document.getElementById('bannerCompName').innerText = 'Xem tổng quan khóa học';
        document.getElementById('bannerTierLevel').innerText = 'TRẠNG THÁI';
        document.getElementById('bannerLevelTitle').innerText = 'Chưa lọc theo Chuẩn đầu ra';
        document.getElementById('bannerLevelBadge').style.display = 'none';
        document.getElementById('bannerIdTag').innerText = 'Tất cả chuẩn CBE';
        document.getElementById('bannerStatementText').innerText = 'Bạn có thể chọn một chuẩn đầu ra ở cột bên trái hoặc bấm nút "Đổi chuẩn năng lực" để lọc các khóa học đáp ứng chuẩn đầu ra tương ứng.';
        document.getElementById('bannerFrameworkName').innerText = FRAMEWORKS_DATA[currentFrameworkKey].name;
        document.getElementById('bannerIntersectionText').innerText = `Đang hiển thị toàn bộ khóa học`;
        return;
      }

      banner.style.borderLeftColor = 'var(--meko-primary)';
      document.getElementById('bannerTierDomain').innerText = 'TẦNG 1';
      document.getElementById('bannerDomainName').innerText = compData.domain.name;
      document.getElementById('bannerTierComp').innerText = 'TẦNG 2';
      document.getElementById('bannerCompName').innerText = `${compData.competency.code}. ${compData.competency.name}`;
      document.getElementById('bannerTierLevel').innerText = 'TẦNG 3';
      document.getElementById('bannerLevelTitle').innerText = compData.level.title;

      const badge = document.getElementById('bannerLevelBadge');
      badge.style.display = 'inline-flex';
      badge.className = `banner-level-badge ${compData.level.badge_class}`;
      badge.innerText = compData.level.code;

      document.getElementById('bannerIdTag').innerText = compData.level.idnumber;
      document.getElementById('bannerStatementText').innerText = compData.level.statement;
      document.getElementById('bannerFrameworkName').innerText = compData.framework.name;

      if (currentCategoryId !== null) {
        const cat = CATEGORIES.find(c => c.id === currentCategoryId);
        document.getElementById('bannerIntersectionText').innerHTML = `Đang lọc kép: thuộc <strong>${cat ? cat.name : ''}</strong>`;
      } else {
        document.getElementById('bannerIntersectionText').innerHTML = `Đang lọc trên <strong>Toàn bộ lĩnh vực</strong>`;
      }
    }

    // 7. Render Courses Grid (Lọc đồng thời Category + Competency)
    function renderCoursesGrid() {
      const grid = document.getElementById('coursesGrid');
      const emptyState = document.getElementById('emptyStateCard');

      // Filter logic:
      let filtered = COURSES_DB.filter(c => {
        // Filter by Category
        if (currentCategoryId !== null && c.category_id !== currentCategoryId) {
          return false;
        }
        // Filter by Competency
        if (currentCompetencyId !== null && !c.competencies.includes(currentCompetencyId)) {
          return false;
        }
        // Filter by Search Query
        if (currentSearchQuery) {
          const q = currentSearchQuery.toLowerCase();
          const match = c.title.toLowerCase().includes(q) ||
                        c.code.toLowerCase().includes(q) ||
                        c.teacher.toLowerCase().includes(q) ||
                        c.summary.toLowerCase().includes(q);
          if (!match) return false;
        }
        return true;
      });

      // Update Counts
      const countStr = String(filtered.length).padStart(2, '0');
      document.getElementById('resultsCount').innerText = countStr;
      const bannerCountEl = document.getElementById('bannerCourseCount');
      if (bannerCountEl) bannerCountEl.innerText = countStr;

      // Handle Empty State
      if (filtered.length === 0) {
        grid.style.display = 'none';
        emptyState.style.display = 'block';

        const cat = CATEGORIES.find(c => c.id === currentCategoryId);
        document.getElementById('emptyCatName').innerText = cat ? `Lĩnh vực "${cat.name}"` : 'lĩnh vực đã chọn';
        document.getElementById('emptyCompName').innerText = currentCompetencyId ? `"${currentCompetencyId}"` : 'chuẩn đầu ra này';

        // Toggle relax buttons
        document.getElementById('btnRelaxCategory').style.display = currentCategoryId !== null ? 'inline-block' : 'none';
        document.getElementById('btnRelaxComp').style.display = currentCompetencyId !== null ? 'inline-block' : 'none';
        return;
      }

      grid.style.display = 'grid';
      emptyState.style.display = 'none';

      let html = '';
      filtered.forEach(c => {
        html += `
          <div class="course-card">
            <div class="card-top-bar"></div>
            <div class="card-body">
              <div class="card-badge-row">
                <span class="card-domain-badge">${c.category_name.split(':')[0]}</span>
                <span class="card-code-badge">${c.code}</span>
              </div>
              <h3 class="course-title">
                <a href="{{{courseviewbase}}}?id=${c.id}">${c.title}</a>
              </h3>
              <p class="course-summary">${c.summary || 'Chưa có mô tả khóa học.'}</p>

              <!-- CBE Target Level Tag -->
              <div class="course-level-tag">
                <div class="level-tag-header">
                  <span class="level-tag-name">Chuẩn đầu ra: ${currentCompetencyId ? currentCompetencyId : (c.competencies[0] || 'Chưa gắn chuẩn')}</span>
                </div>
              </div>

              <div class="card-meta-list">
                <div class="meta-row"><span>Giảng viên:</span> <span class="meta-val">${c.teacher || 'Chưa công bố'}</span></div>
                <div class="meta-row"><span>Khai giảng:</span> <span class="meta-val">${c.startdate || 'Chưa công bố'}</span></div>
                <div class="meta-row"><span>Lĩnh vực:</span> <span class="meta-val">${c.category_name.split(':')[1] || c.category_name}</span></div>
              </div>
            </div>

            <div class="card-footer">
              <a href="{{{courseviewbase}}}?id=${c.id}" class="btn-view-course">
                <span>Vào học</span> &rarr;
              </a>
            </div>
          </div>
        `;
      });

      grid.innerHTML = html;
    }

    function handleCourseSearch(val) {
      currentSearchQuery = val.trim();
      renderCoursesGrid();
    }

    // ==============================================
    // MODAL PICKER CONTROLLER
    // ==============================================
    function openCompetencyModal() {
      document.getElementById('competencyModal').classList.add('active');
      renderModalBody('');
    }

    function closeCompetencyModal() {
      document.getElementById('competencyModal').classList.remove('active');
    }

    function closeCompetencyModalOnBackdrop(e) {
      if (e.target.id === 'competencyModal') {
        closeCompetencyModal();
      }
    }

    function updateModalTabs() {
      const btnSv = document.getElementById('modalTabBtnStudents');
      const btnGv = document.getElementById('modalTabBtnFaculty');
      if (btnSv) btnSv.className = `framework-tab-btn ${currentFrameworkKey === 'students' ? 'active' : ''}`;
      if (btnGv) btnGv.className = `framework-tab-btn ${currentFrameworkKey === 'faculty' ? 'active' : ''}`;
    }

    function handleModalSearch(query) {
      renderModalBody(query.trim().toLowerCase());
    }

    function renderModalBody(q) {
      const container = document.getElementById('modalBodyScroll');
      const fw = FRAMEWORKS_DATA[currentFrameworkKey];
      let html = '';

      fw.domains.forEach(d => {
        let matchingComp = d.competencies;
        if (q) {
          matchingComp = d.competencies.filter(c => {
            const inName = c.name.toLowerCase().includes(q) || c.code.toLowerCase().includes(q);
            const inLevels = c.levels.some(l => l.title.toLowerCase().includes(q) || l.statement.toLowerCase().includes(q) || l.idnumber.toLowerCase().includes(q));
            return inName || inLevels;
          });
        }

        if (matchingComp.length === 0) return;

        html += `
          <div class="modal-domain-section">
            <div class="modal-domain-heading">
              <span>${d.name}</span>
            </div>
            <div class="modal-comp-grid">
        `;

        matchingComp.forEach(c => {
          html += `
            <div class="modal-comp-card">
              <div class="modal-comp-header">
                <strong>${c.code}. ${c.name}</strong>
              </div>
              <div class="modal-comp-statement-sample">
                ${c.levels[0] ? c.levels[0].statement.substring(0, 85) + '...' : ''}
              </div>
              <div class="modal-levels-row">
          `;

          c.levels.forEach(lvl => {
            const isSelected = lvl.idnumber === currentCompetencyId;
            html += `
              <button class="btn-select-level ${isSelected ? 'active' : ''}" onclick="setCompetency('${lvl.idnumber}')" title="${lvl.statement}">
                ${lvl.title} (${lvl.code})
              </button>
            `;
          });

          html += `
              </div>
            </div>
          `;
        });

        html += `
            </div>
          </div>
        `;
      });

      if (!html) {
        html = `
          <div style="text-align: center; padding: 40px; color: #94A3B8;">
            <div style="font-size: 28px; margin-bottom: 8px;"></div>
            <p>Không tìm thấy chuẩn năng lực nào khớp với từ khóa "<strong>${q}</strong>".</p>
          </div>
        `;
      }

      container.innerHTML = html;
    }

    function handleSidebarCompSearch(q) {
      const query = q.trim().toLowerCase();
      const fw = FRAMEWORKS_DATA[currentFrameworkKey];
      const treeContainer = document.getElementById('compTreeList');

      if (!query) {
        renderSidebarCompetencyTree();
        return;
      }

      let html = '';
      fw.domains.forEach(d => {
        const matchingComp = d.competencies.filter(c => {
          return c.name.toLowerCase().includes(query) ||
                 c.code.toLowerCase().includes(query) ||
                 c.levels.some(l => l.idnumber.toLowerCase().includes(query) || l.code.toLowerCase().includes(query));
        });

        if (matchingComp.length === 0) return;

        html += `
          <li class="comp-tree-domain">
            <div class="domain-title-bar" style="background: #EEF2FF; color: var(--meko-primary);">
              <span>${d.name}</span>
              <span style="font-size: 11px;">▾</span>
            </div>
            <ul class="domain-comp-list" style="display: block;">
        `;

        matchingComp.forEach(c => {
          html += `
            <li class="comp-item-block">
              <div class="comp-item-title">
                <span>${c.code}. ${c.name}</span>
              </div>
              <div class="comp-levels-pills">
          `;

          c.levels.forEach(lvl => {
            const isActive = lvl.idnumber === currentCompetencyId;
            html += `
              <button class="comp-level-btn ${isActive ? 'active' : ''}" onclick="setCompetency('${lvl.idnumber}')">
                ${lvl.code}
              </button>
            `;
          });

          html += `
              </div>
            </li>
          `;
        });

        html += `
            </ul>
          </li>
        `;
      });

      treeContainer.innerHTML = html || '<li style="padding: 12px; text-align: center; color: #94A3B8; font-size: 12px;">Không tìm thấy</li>';
    }

</script>
</div>
